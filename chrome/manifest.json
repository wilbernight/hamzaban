{
  "manifest_version": 3,
  "name": "هم‌زبان — دوبله‌ی فارسی",
  "short_name": "هم‌زبان",
  "description": "دوبله‌ی فارسی همزمان هر ویدیو، با هوش مصنوعی آفلاین روی همین کامپیوتر.",
  "version": "1.0.0",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "هم‌زبان — دوبله‌ی فارسی",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "contextMenus", "cookies"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://*.udemycdn.com/*", "https://*.youtube.com/*"],
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{ "resources": ["fonts/Vazirmatn.woff2", "capture-worklet.js"], "matches": ["http://*/*", "https://*/*"] }]
}
